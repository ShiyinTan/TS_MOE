# Local data and experiment outputs (see README / docs/experiments.md)
/data/
/runs/
/results/*
# Keep per-city Acc climb bundles (path / settings summary / mean±std)
!/results/*/
/results/*/*
!/results/*/README.md
!/results/*/climb_path.md
!/results/*/settings_summary.md
!/results/*/settings_summary.csv
!/results/*/mean_std.md
!/results/*/mean_std.csv

# Intermediate climb densify waves (GPU-local only).
# Commit a config only after Acc lock via scripts/promote_climb_config.py.
# Recipe overrides for regen: w17 template is committed; later waves are GPU-local.
configs/*/*_w[0-9]*_*.yaml
configs/*/*_w[0-9][0-9]*_*.yaml
scripts/data/mel_w*_overrides.json
!scripts/data/mel_w17_overrides.json

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
